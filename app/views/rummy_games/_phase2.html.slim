/ # locals: (can_meld:, game:, meld_options:, hand_cards:)

- if can_meld
	= simple_form_for :turn, url: play_turn_path(game), html: { class: "game-actions"} do |f|
		div.op-stack.gap-xs
			= f.input :meld,
				as: :select,
				collection: meld_options,
				selected: meld_options.values.first,
				include_blank: false
			div.grid-col-2
				- hand_cards.each do |label, value|
					label
						input type="checkbox" name="turn[cards][]" value=value
						= label

			= f.button :button, "Meld/Lay-off Selected"
